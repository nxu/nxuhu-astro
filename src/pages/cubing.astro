---
import CubingStats from '../components/CubingStats.vue';
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout activeMenu="cubing">
    <h1 class="text-4xl font-bold">
        My speedcubing stats
    </h1>

    <p class="mt-4">
        Currently I have a MoYu RS3M V5 (Ball Core), 
        and use <a href="https://github.com/nxu/nscramble-app" class="underline">my vibe-coded app called nscramble</a> for timing and scrambles.
    </p>

    <CubingStats client:only></CubingStats>
</MainLayout>
